#!/usr/bin/env sh
# Bullet - tiny Termux AI CLI shell
# Offline first. Optional online AI via OpenAI-compatible API.

set -u
VERSION="0.6.0"
DATA_DIR="${BULLET_HOME:-$HOME/.bullet}"
CONFIG="$DATA_DIR/config"
NOTES="$DATA_DIR/notes.md"
CHAT_LOG="$DATA_DIR/chat-history.md"
AGI_MEM="$DATA_DIR/agi-memory.md"
AGI_TASKS="$DATA_DIR/agi-tasks.md"
DEFAULT_BASE="https://api.openai.com/v1"
DEFAULT_MODEL="gpt-4o-mini"

# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

API_BASE="${BULLET_API_BASE:-$DEFAULT_BASE}"
MODEL="${BULLET_MODEL:-$DEFAULT_MODEL}"
API_KEY="${BULLET_API_KEY:-}"
OFFLINE="${BULLET_OFFLINE:-0}"

mkdirp() { [ -d "$1" ] || mkdir -p "$1"; }

is_on() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on|offline) return 0 ;;
    *) return 1 ;;
  esac
}

use_offline_ai() {
  is_on "$OFFLINE" || { [ -z "$API_KEY" ] && [ "$API_BASE" = "$DEFAULT_BASE" ]; }
}

mode_text() {
  if use_offline_ai; then
    printf offline
  else
    printf online
  fi
}

shell_quote() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g; 1s/^/'/; \$s/\$/'/"
}

json_escape() {
  # Good enough for prompts sent to OpenAI-compatible chat APIs.
  printf "%s" "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; :a; N; $!ba; s/\n/\\n/g'
}

extract_text() {
  if command -v jq >/dev/null 2>&1; then
    jq -r '.choices[0].message.content // .output_text // .error.message // empty'
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; d=json.load(sys.stdin); print((((d.get("choices") or [{}])[0].get("message") or {}).get("content")) or d.get("output_text") or (d.get("error") or {}).get("message") or "")'
    return
  fi
  tr '\n' ' ' | sed -n 's/.*"content"[[:space:]]*:[[:space:]]*"\([^"\\]*\(\\.[^"\\]*\)*\)".*/\1/p' | sed 's/\\n/\
/g; s/\\"/"/g; s/\\\\/\\/g'
}

offline_ai() {
  prompt="$*"
  p=$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')

  case "$p" in
    *help*|*topic*|*what\ can\ you\ do*|"")
      cat <<EOF
Bullet offline AI is running locally from built-in Termux recipes.
Try:
  bullet offline "storage clean"
  bullet offline "backup home"
  bullet offline "python setup"
  bullet offline "git setup"
  bullet offline "find large files"
  bullet chat
  bullet chat "hello"
  bullet agi "make my Termux faster"
  bullet note "idea" && bullet notes
No internet, key, Python, or model is required.
EOF
      ;;
    hello|hello\ *|hi|hi\ *|hey|hey\ *|*chatbot*|*chat\ bot*)
      cat <<EOF
Hi, I am Bullet AI Chat Bot.
I can chat offline using built-in Termux recipes, or online if you configure an OpenAI-compatible API.
Try:
  bullet chat "storage clean"
  bullet chat "backup home"
  bullet chat history
  bullet agi "plan my Termux setup"
EOF
      ;;
    *agi*|*agent*|*goal*)
      cat <<EOF
Offline AGI mode is available as a tiny local goal agent.
This is not real AGI; in Bullet, AGI means Autonomous Goal Interface.
Use:
  bullet agi "your goal"
  bullet agi tasks
  bullet agi remember "important context"
  bullet agi memory
EOF
      ;;
    *storage*|*space*|*clean*|*delete\ cache*|*free*)
      cat <<EOF
Offline plan: free Termux storage safely.
Commands:
  du -h -d 1 ~ | sort -h
  apt clean 2>/dev/null || pkg clean
  rm -rf ~/.cache/* 2>/dev/null
  find ~ -type f -size +100M -print
Avoid deleting Android shared folders unless you know the files.
EOF
      ;;
    *backup*|*archive*|*tar*)
      cat <<EOF
Offline plan: backup your Termux home.
Commands:
  cd ~
  tar -czf termux-home-backup.tgz --exclude .cache .
  ls -lh termux-home-backup.tgz
Restore later with:
  mkdir restore && tar -xzf termux-home-backup.tgz -C restore
EOF
      ;;
    *find*large*|*big*file*|*large\ file*)
      cat <<EOF
Offline plan: find large files.
Commands:
  find ~ -type f -size +50M -print 2>/dev/null
  du -h -d 2 ~ 2>/dev/null | sort -h | tail -30
Tip: inspect before deleting.
EOF
      ;;
    *storage\ permission*|*shared\ storage*|*sdcard*|*download*)
      cat <<EOF
Offline plan: enable Android shared storage in Termux.
Command:
  termux-setup-storage
Then check:
  ls ~/storage/downloads
  ls /sdcard
EOF
      ;;
    *python*|*pip*)
      cat <<EOF
Offline recipe: Python in Termux.
If packages are already installed:
  python --version
  python script.py
When online later, install with:
  pkg install python
  python -m pip install --upgrade pip
EOF
      ;;
    *git*|*github*|*clone*)
      cat <<EOF
Offline recipe: Git basics.
Commands that work offline inside an existing repo:
  git status
  git add FILE
  git commit -m "message"
  git log --oneline -5
Network commands like clone/pull/push need internet.
EOF
      ;;
    *network*|*wifi*|*ip\ addr*|*internet*|*ping*)
      cat <<EOF
Offline/local network checks:
  ip addr
  getprop wifi.interface 2>/dev/null
  ping -c 3 127.0.0.1
Internet checks, only when online:
  ping -c 3 8.8.8.8
  curl -I https://example.com
EOF
      ;;
    *battery*|*sms*|*contact*|*termux-api*)
      cat <<EOF
Offline recipe: Termux Android APIs.
Install the Termux:API app and package when available:
  pkg install termux-api
Examples:
  termux-battery-status
  termux-wifi-connectioninfo
These commands use local Android APIs, not cloud AI.
EOF
      ;;
    *process*|*running*|*kill*|*top*)
      cat <<EOF
Offline recipe: inspect running processes.
Commands:
  ps -A
  top
  pkill -f NAME
Be careful with kill/pkill; unsaved work can be lost.
EOF
      ;;
    *install*|*package*|*pkg*|*apt*)
      cat <<EOF
Offline package note:
  pkg list-installed
  dpkg -l
Installing new packages usually needs internet or a local repo/cache.
When online:
  pkg update
  pkg install PACKAGE
EOF
      ;;
    *run\ offline*|*offline*)
      cat <<EOF
Bullet is in offline mode now.
Use:
  bullet offline "help"
  bullet offline "storage clean"
  BULLET_OFFLINE=1 bullet ask "backup home"
Plain built-ins also work offline:
  bullet note "idea"
  bullet notes
  bullet sys
  bullet run "pwd"
EOF
      ;;
    *)
      cat <<EOF
Bullet offline AI answer for: $prompt
I am running without internet or a model, so I can only use built-in Termux recipes.
Useful offline commands:
  bullet offline "help"
  bullet agi "plan my goal"
  bullet offline "storage clean"
  bullet offline "backup home"
  bullet offline "find large files"
  bullet sys
For a real local LLM later, point Bullet at a local OpenAI-compatible server:
  BULLET_API_BASE=http://127.0.0.1:11434/v1 BULLET_MODEL=tinyllama bullet ask "$prompt"
EOF
      ;;
  esac
}

ai() {
  prompt="$*"
  [ -n "$prompt" ] || { printf 'Ask what?\n' >&2; return 2; }

  if use_offline_ai; then
    offline_ai "$prompt"
    return 0
  fi
  command -v curl >/dev/null 2>&1 || { printf 'curl is required for online AI. In Termux: pkg install curl\n' >&2; return 127; }

  system='You are Bullet, a tiny Termux AI CLI assistant. Be concise, practical, and safe. Prefer commands that work in Termux. Warn before destructive commands.'
  eprompt=$(json_escape "$prompt")
  esystem=$(json_escape "$system")
  emodel=$(json_escape "$MODEL")
  body=$(printf '{"model":"%s","messages":[{"role":"system","content":"%s"},{"role":"user","content":"%s"}],"temperature":0.2}' "$emodel" "$esystem" "$eprompt")

  if [ -n "$API_KEY" ]; then
    resp=$(curl -fsS "$API_BASE/chat/completions" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $API_KEY" \
      -d "$body") || { printf 'AI request failed. Check key/base/model/network. Try: BULLET_OFFLINE=1 bullet ask "%s"\n' "$prompt" >&2; return 1; }
  else
    resp=$(curl -fsS "$API_BASE/chat/completions" \
      -H "Content-Type: application/json" \
      -d "$body") || { printf 'AI request failed. Check base/model/network. Try: BULLET_OFFLINE=1 bullet ask "%s"\n' "$prompt" >&2; return 1; }
  fi

  text=$(printf '%s' "$resp" | extract_text)
  [ -n "$text" ] && printf '%s\n' "$text" || printf '%s\n' "$resp"
}

save_config() {
  key="${1:-}"
  model="${2:-$MODEL}"
  base="${3:-$API_BASE}"
  [ -n "$key" ] || { printf 'Usage: bullet config KEY [MODEL] [BASE_URL]\n' >&2; return 2; }
  mkdirp "$DATA_DIR"
  umask 077
  {
    printf 'BULLET_API_KEY=%s\n' "$(shell_quote "$key")"
    printf 'BULLET_MODEL=%s\n' "$(shell_quote "$model")"
    printf 'BULLET_API_BASE=%s\n' "$(shell_quote "$base")"
  } > "$CONFIG"
  printf 'Saved config to %s\n' "$CONFIG"
}

add_note() {
  note="$*"
  [ -n "$note" ] || { printf 'Usage: bullet note "text"\n' >&2; return 2; }
  mkdirp "$DATA_DIR"
  printf -- '- %s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$note" >> "$NOTES"
  printf 'Saved note.\n'
}

show_notes() {
  [ -f "$NOTES" ] && cat "$NOTES" || printf 'No notes yet.\n'
}

agi_usage() {
  cat <<EOF
Bullet AGI - Autonomous Goal Interface

This is a tiny offline goal agent, not real artificial general intelligence.
It turns a goal into an observe/plan/act/review checklist and stores memory.

Usage:
  bullet agi "GOAL"              Plan a goal locally
  bullet agi plan "GOAL"         Same as above
  bullet agi remember TEXT       Save AGI memory/context
  bullet agi memory              Show AGI memory
  bullet agi tasks               Show saved AGI goals

Examples:
  bullet agi "make my Termux faster"
  bullet agi "backup my home folder"
  bullet agi "prepare a Python coding setup"
EOF
}

agi_plan() {
  goal="$*"
  p=$(printf '%s' "$goal" | tr '[:upper:]' '[:lower:]')

  case "$p" in
    *storage*|*space*|*clean*|*fast*|*faster*|*optimi*)
      cat <<EOF
Observe:
  1. Measure biggest folders before changing anything.
  2. Check package cache and user cache.
Plan:
  1. Review disk usage.
  2. Clean package/cache files only.
  3. Find large files and inspect them manually.
Act candidates:
  bullet run "du -h -d 1 ~ 2>/dev/null | sort -h"
  bullet run "apt clean 2>/dev/null || pkg clean"
  bullet run "find ~ -type f -size +100M -print 2>/dev/null"
Review:
  Run bullet sys, then compare free space. Do not delete unknown Android files.
EOF
      ;;
    *backup*|*restore*|*archive*|*save\ my*)
      cat <<EOF
Observe:
  1. Check available storage.
  2. Decide what to exclude: cache, downloads, build folders.
Plan:
  1. Create a compressed archive of Termux home.
  2. Verify the archive exists and has size.
  3. Move/copy it to shared storage if needed.
Act candidates:
  bullet run "cd ~ && tar -czf termux-home-backup.tgz --exclude .cache ."
  bullet run "ls -lh ~/termux-home-backup.tgz"
  bullet run "mkdir -p ~/storage/downloads 2>/dev/null; cp ~/termux-home-backup.tgz ~/storage/downloads/ 2>/dev/null"
Review:
  Test restore in a temp folder before trusting any backup.
EOF
      ;;
    *python*|*coding*|*code*|*program*|*script*|*dev*)
      cat <<EOF
Observe:
  1. Check installed languages and current project files.
  2. Identify the smallest next runnable script or test.
Plan:
  1. Confirm Python/Git availability.
  2. Create or edit one small file.
  3. Run it, inspect output, then iterate.
Act candidates:
  bullet run "python --version 2>/dev/null || echo 'python not installed'"
  bullet run "git status 2>/dev/null || pwd"
  bullet run "ls -la"
Review:
  Keep changes small. Save notes with bullet note "what changed".
EOF
      ;;
    *git*|*github*|*commit*|*repo*)
      cat <<EOF
Observe:
  1. Check repository state.
  2. Read changed files before committing.
Plan:
  1. Run status and diff.
  2. Stage only intended files.
  3. Commit with a clear message.
Act candidates:
  bullet run "git status --short"
  bullet run "git diff --stat"
  bullet run "git log --oneline -5"
Review:
  Push/pull/clone need internet. Never commit secrets.
EOF
      ;;
    *learn*|*study*|*exam*|*plan*)
      cat <<EOF
Observe:
  1. Define the topic and deadline.
  2. List what you already know.
Plan:
  1. Split into 3 small study blocks.
  2. Create one practice task per block.
  3. Review errors and save notes.
Act candidates:
  bullet note "Study goal: $goal"
  bullet note "Next study block: 25 minutes"
  bullet notes
Review:
  Use short sessions. Update AGI memory with bullet agi remember "progress".
EOF
      ;;
    *phone*|*android*|*battery*|*api*)
      cat <<EOF
Observe:
  1. Check system info and available Termux APIs.
  2. Check whether Termux:API app/package is installed.
Plan:
  1. Run local system checks.
  2. Use Android API commands only if installed.
  3. Save useful readings to notes.
Act candidates:
  bullet sys
  bullet run "command -v termux-battery-status && termux-battery-status || echo 'termux-api not installed'"
  bullet run "command -v termux-wifi-connectioninfo && termux-wifi-connectioninfo || true"
Review:
  Android permission prompts may appear on the phone.
EOF
      ;;
    *)
      cat <<EOF
Observe:
  1. Restate the goal in one sentence: $goal
  2. List files, tools, constraints, and risks.
Plan:
  1. Break the goal into the smallest safe next action.
  2. Prefer read-only checks first.
  3. Act once, then review the result.
Act candidates:
  bullet sys
  bullet notes
  bullet run "pwd && ls -la"
Review:
  Save what you learn with bullet agi remember "..." and rerun bullet agi with a sharper goal.
EOF
      ;;
  esac
}

agi_goal() {
  goal="$*"
  [ -n "$goal" ] || { agi_usage; return 2; }
  now=$(date '+%Y-%m-%d %H:%M')
  plan=$(agi_plan "$goal")
  mkdirp "$DATA_DIR"
  {
    printf '\n## %s\n' "$now"
    printf 'Goal: %s\n\n' "$goal"
    printf '%s\n' "$plan"
  } >> "$AGI_MEM"
  printf -- '- [ ] %s  %s\n' "$now" "$goal" >> "$AGI_TASKS"

  printf 'Bullet AGI: Autonomous Goal Interface (offline, tiny, not real AGI)\n'
  printf 'Goal: %s\n\n' "$goal"
  printf '%s\n\n' "$plan"
  printf 'Saved memory: %s\n' "$AGI_MEM"
  printf 'Saved task: %s\n' "$AGI_TASKS"
}

agi_remember() {
  text="$*"
  [ -n "$text" ] || { printf 'Usage: bullet agi remember TEXT\n' >&2; return 2; }
  mkdirp "$DATA_DIR"
  printf -- '- %s  %s\n' "$(date '+%Y-%m-%d %H:%M')" "$text" >> "$AGI_MEM"
  printf 'Saved AGI memory.\n'
}

agi_show_file() {
  file="$1"
  empty_msg="$2"
  [ -f "$file" ] && cat "$file" || printf '%s\n' "$empty_msg"
}

agi_cmd() {
  [ $# -gt 0 ] || { agi_usage; return 0; }
  sub="$1"
  case "$sub" in
    help|-h|--help) [ $# -eq 1 ] && agi_usage || agi_goal "$@" ;;
    memory|mem) agi_show_file "$AGI_MEM" "No AGI memory yet." ;;
    tasks|task|goals) agi_show_file "$AGI_TASKS" "No AGI tasks yet." ;;
    remember) shift; agi_remember "$@" ;;
    plan|goal|run) shift; agi_goal "$@" ;;
    *) agi_goal "$@" ;;
  esac
}


chat_usage() {
  cat <<EOF
Bullet AI Chat Bot

Usage:
  bullet chat                 Start interactive AI chat bot
  bullet chat TEXT            Send one message to the bot
  bullet chat history         Show saved chat history
  bullet chat clear           Clear saved chat history

Inside chat:
  /help, /history, /clear, /sys, /agi GOAL, /note TEXT, /offline TEXT, /exit

History file:
  $CHAT_LOG
EOF
}

recent_chat_history() {
  [ -f "$CHAT_LOG" ] || return 0
  if command -v tail >/dev/null 2>&1; then
    tail -60 "$CHAT_LOG" 2>/dev/null || true
  else
    cat "$CHAT_LOG" 2>/dev/null || true
  fi
}

show_chat_history() {
  [ -s "$CHAT_LOG" ] && cat "$CHAT_LOG" || printf 'No chat history yet.\n'
}

clear_chat_history() {
  mkdirp "$DATA_DIR"
  : > "$CHAT_LOG"
  printf 'Chat history cleared.\n'
}

chat_ask() {
  msg="$*"
  [ -n "$msg" ] || { printf 'Chat message?\n' >&2; return 2; }
  mkdirp "$DATA_DIR"
  now=$(date '+%Y-%m-%d %H:%M')
  hist=$(recent_chat_history)
  prompt=$(cat <<EOF
You are Bullet AI Chat Bot running in Termux.
Be concise, practical, friendly, and safe. Prefer offline Termux commands when possible.
Recent chat history:
$hist

User message:
$msg
EOF
)

  printf '\n## %s\nUser: %s\n\n' "$now" "$msg" >> "$CHAT_LOG"
  if use_offline_ai; then
    reply=$(offline_ai "$msg" 2>&1)
  else
    reply=$(ai "$prompt" 2>&1)
  fi
  status=$?
  if [ "$status" -ne 0 ]; then
    printf 'bot> AI error. Try offline mode: bullet offline "%s"\n' "$msg"
    printf 'Bot error: %s\n\n' "$reply" >> "$CHAT_LOG"
    return "$status"
  fi
  printf '%s\n' "$reply" | sed 's/^/bot> /'
  printf 'Bot: %s\n\n' "$reply" >> "$CHAT_LOG"
}

chat_bot() {
  mkdirp "$DATA_DIR"
  printf 'Bullet AI Chat Bot. Type /help or /exit. History: %s\n' "$CHAT_LOG"
  while :; do
    printf 'you> '
    IFS= read -r line || break
    case "$line" in
      '') ;;
      /exit|exit|quit|/quit) break ;;
      /help) chat_usage ;;
      /history) show_chat_history ;;
      /clear) clear_chat_history ;;
      /sys) show_sys ;;
      /agi\ *) agi_goal "${line#/agi }" ;;
      /note\ *) add_note "${line#/note }" ;;
      /offline\ *) offline_ai "${line#/offline }" ;;
      /*) printf 'Unknown chat command. Type /help.\n' >&2 ;;
      *) chat_ask "$line" ;;
    esac
  done
}

chat_cmd() {
  if [ $# -eq 0 ]; then
    chat_bot
    return
  fi
  sub="$1"
  case "$sub" in
    help|-h|--help) chat_usage ;;
    history|hist|log) show_chat_history ;;
    clear|reset) clear_chat_history ;;
    *) chat_ask "$@" ;;
  esac
}

show_sys() {
  printf 'Bullet %s\n' "$VERSION"
  printf 'Home: %s\n' "$DATA_DIR"
  printf 'Mode: %s\n' "$(mode_text)"
  printf 'Model: %s\n' "$MODEL"
  printf 'Base: %s\n' "$API_BASE"
  printf 'Key: %s\n' "$( [ -n "$API_KEY" ] && printf configured || printf missing )"
  printf 'AGI: %s\n' "Autonomous Goal Interface"
  printf 'Chat: %s\n' "$CHAT_LOG"
  printf '\nSystem:\n'
  uname -a 2>/dev/null || true
  printf '\nStorage:\n'
  df -h "$HOME" 2>/dev/null || true
}

doctor() {
  show_sys
  printf '\nChecks:\n'
  command -v curl >/dev/null 2>&1 && printf 'OK curl: %s\n' "$(command -v curl)" || printf 'OPT curl (needed only for online AI; Termux: pkg install curl)\n'
  command -v jq >/dev/null 2>&1 && printf 'OK jq: %s\n' "$(command -v jq)" || printf 'OPT jq (better online JSON parsing; Termux: pkg install jq)\n'
}


self_test() {
  old_data="$DATA_DIR"
  old_config="$CONFIG"
  old_notes="$NOTES"
  old_chat="$CHAT_LOG"
  old_mem="$AGI_MEM"
  old_offline="$OFFLINE"
  old_api_key="$API_KEY"
  old_api_base="$API_BASE"
  old_tasks="$AGI_TASKS"
  tmp="${TMPDIR:-/tmp}/bullet-test-$$"
  rm -rf "$tmp" 2>/dev/null || true
  mkdirp "$tmp" || { printf 'FAIL create temp dir\n' >&2; return 1; }

  DATA_DIR="$tmp"
  CONFIG="$DATA_DIR/config"
  NOTES="$DATA_DIR/notes.md"
  CHAT_LOG="$DATA_DIR/chat-history.md"
  AGI_MEM="$DATA_DIR/agi-memory.md"
  AGI_TASKS="$DATA_DIR/agi-tasks.md"
  OFFLINE=1
  API_KEY=""
  API_BASE="$DEFAULT_BASE"
  fail=0

  printf 'Bullet self-test (%s)\n' "$VERSION"

  [ -n "$VERSION" ] && printf 'OK version\n' || { printf 'FAIL version\n'; fail=$((fail + 1)); }
  offline_ai help >/dev/null 2>&1 && printf 'OK offline recipes\n' || { printf 'FAIL offline recipes\n'; fail=$((fail + 1)); }
  agi_goal "test offline AGI" >/dev/null 2>&1 && [ -s "$AGI_MEM" ] && [ -s "$AGI_TASKS" ] && printf 'OK AGI plan/memory\n' || { printf 'FAIL AGI plan/memory\n'; fail=$((fail + 1)); }
  add_note "test note" >/dev/null 2>&1 && [ -s "$NOTES" ] && printf 'OK notes\n' || { printf 'FAIL notes\n'; fail=$((fail + 1)); }
  chat_ask "test storage clean" >/dev/null 2>&1 && [ -s "$CHAT_LOG" ] && printf 'OK chat bot\n' || { printf 'FAIL chat bot\n'; fail=$((fail + 1)); }
  show_sys >/dev/null 2>&1 && printf 'OK sys\n' || { printf 'FAIL sys\n'; fail=$((fail + 1)); }

  DATA_DIR="$old_data"
  CONFIG="$old_config"
  NOTES="$old_notes"
  CHAT_LOG="$old_chat"
  AGI_MEM="$old_mem"
  AGI_TASKS="$old_tasks"
  OFFLINE="$old_offline"
  API_KEY="$old_api_key"
  API_BASE="$old_api_base"
  rm -rf "$tmp" 2>/dev/null || true

  if [ "$fail" -eq 0 ]; then
    printf 'PASS all tests\n'
    return 0
  fi
  printf 'FAIL %s test(s)\n' "$fail"
  return "$fail"
}

fix_cmd() {
  topic="$*"
  p=$(printf '%s' "$topic" | tr '[:upper:]' '[:lower:]')
  case "$p" in
    ''|help|-h|--help)
      cat <<EOF
Bullet Fix mode - safe Termux repair helper

Use:
  bullet fix big          Run self-test and print safe repair checklist
  bullet fix path         Fix/diagnose "bullet: not found"
  bullet fix install      Reinstall bullet to \$PREFIX/bin
  bullet fix storage      Storage cleanup plan
  bullet fix permission   Android storage permission plan
  bullet fix git          Git/repo checks
  bullet test             Run built-in self-test
  bullet legend           Auto build/update/install/test runner

Fix mode prints safe commands first. It does not delete personal files.
EOF
      ;;
    *big*|*all*|*termux*)
      printf 'Bullet BIG FIX (safe)\n\n'
      self_test
      printf '\nSafe checklist:\n'
      printf '  1. Refresh shell command cache: hash -r\n'
      printf '  2. Check install path: command -v bullet\n'
      printf '  3. Reinstall if needed: sh install-termux.sh\n'
      printf '  4. Check mode/system: bullet doctor\n'
      printf '  5. Run offline AGI: bullet agi "fix my Termux"\n'
      printf '\nCopy-paste one command:\n'
      printf '  hash -r && bullet test && bullet doctor && bullet agi "fix my Termux"\n'
      ;;
    *path*|*not\ found*|*command*)
      cat <<EOF
Fix: bullet command not found
Run:
  hash -r
  command -v bullet
If empty, reinstall from the repo folder:
  sh install-termux.sh
If you are outside the repo:
  cd Fix- && sh install-termux.sh
Termux normal install path:
  /data/data/com.termux/files/usr/bin/bullet
EOF
      ;;
    *install*|*reinstall*)
      install_self
      ;;
    *storage*|*space*|*clean*)
      offline_ai "storage clean"
      ;;
    *permission*|*sdcard*|*download*)
      offline_ai "storage permission"
      ;;
    *git*|*repo*|*pull*)
      cat <<EOF
Fix: Git/repo checks
Run inside the repo:
  pwd
  git status --short
  git branch --show-current
  git pull
If you need this branch:
  git fetch origin arena/01a0f681-fix
  git checkout arena/01a0f681-fix
EOF
      ;;
    *)
      printf 'Fix plan for: %s\n\n' "$topic"
      agi_plan "fix $topic"
      ;;
  esac
}


legend_cmd() {
  mode="${1:-safe}"
  p=$(printf '%s' "$*" | tr '[:upper:]' '[:lower:]')
  printf 'Bullet Legend Auto Runner (%s)\n' "$VERSION"
  printf 'Mode: %s\n\n' "$mode"

  printf '== 1. Build/check ==\n'
  if [ -f ./bullet ]; then
    sh -n ./bullet && printf 'OK syntax: ./bullet\n' || printf 'WARN syntax check failed: ./bullet\n'
    chmod +x ./bullet 2>/dev/null || true
  else
    printf 'INFO no ./bullet in current folder, using installed script.\n'
  fi
  if [ -f ./install-termux.sh ]; then
    sh -n ./install-termux.sh && printf 'OK syntax: ./install-termux.sh\n' || printf 'WARN syntax check failed: ./install-termux.sh\n'
    chmod +x ./install-termux.sh 2>/dev/null || true
  fi

  printf '\n== 2. Update code ==\n'
  if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    branch=$(git branch --show-current 2>/dev/null || true)
    if [ -n "$branch" ]; then
      printf 'Git branch: %s\n' "$branch"
      git fetch origin "$branch" || printf 'WARN git fetch failed. Check internet/repo.\n'
      git pull --ff-only origin "$branch" || printf 'WARN git pull failed. Commit/stash local changes or check internet.\n'
    else
      printf 'WARN detached git state; skipping pull.\n'
    fi
  else
    printf 'INFO not inside a git repo or git missing; skipping code pull.\n'
  fi

  printf '\n== 3. Upgrade packages ==\n'
  upgrade_pkgs=0
  is_on "${BULLET_LEGEND_UPGRADE:-0}" && upgrade_pkgs=1
  case "$p" in *upgrade*|*full*|*all*) upgrade_pkgs=1 ;; esac
  if [ "$upgrade_pkgs" = "1" ]; then
    if command -v pkg >/dev/null 2>&1; then
      pkg update -y || printf 'WARN pkg update failed.\n'
      pkg upgrade -y || printf 'WARN pkg upgrade failed.\n'
    elif command -v apt >/dev/null 2>&1; then
      apt update || printf 'WARN apt update failed.\n'
      apt upgrade -y || printf 'WARN apt upgrade failed.\n'
    else
      printf 'INFO no pkg/apt found; skipping package upgrade.\n'
    fi
  else
    printf 'SKIP package upgrade. To run it: bullet legend upgrade\n'
  fi

  printf '\n== 4. Install/update Bullet ==\n'
  if [ -f ./install-termux.sh ] && [ -f ./bullet ]; then
    sh ./install-termux.sh || printf 'WARN install-termux.sh failed.\n'
  else
    install_self || printf 'WARN install_self failed.\n'
  fi
  hash -r 2>/dev/null || true

  printf '\n== 5. Bug fix/self-test ==\n'
  self_test || printf 'WARN self-test reported failure.\n'

  printf '\n== 6. Doctor ==\n'
  doctor

  printf '\nLegend complete. Next commands:\n'
  printf '  bullet chat hello\n'
  printf '  bullet bigfix\n'
  printf '  bullet legend upgrade\n'
}

install_self() {
  dest="${PREFIX:-$HOME/.local}/bin"
  src="$0"
  case "$src" in
    */*) ;;
    *) src=$(command -v "$src" 2>/dev/null || printf '%s' "$src") ;;
  esac
  [ -f "$src" ] || { printf 'Cannot find Bullet source script: %s\n' "$src" >&2; return 1; }

  mkdirp "$dest" || return 1
  target="$dest/bullet"
  if [ "$src" != "$target" ] && ! cmp -s "$src" "$target" 2>/dev/null; then
    cp "$src" "$target" || return 1
  fi
  chmod +x "$target" || return 1
  hash -r 2>/dev/null || true
  printf 'Installed to %s\n' "$target"
  printf 'Run: bullet test\n'
  printf 'Run: bullet doctor\n'
  printf 'If needed, add to PATH: export PATH="%s:$PATH"\n' "$dest"
}

usage() {
  cat <<EOF
Bullet - mini Termux AI CLI (${VERSION})

Usage:
  bullet                  Start mini shell
  bullet ask TEXT         Ask AI; offline fallback if no API is configured
  bullet offline TEXT     Force local offline recipes, no network
  bullet chat [TEXT]      Interactive AI chat bot, or one message
  bullet agi GOAL         Offline AGI-style goal planner and memory
  bullet agi tasks        Show saved AGI goals
  bullet agi memory       Show AGI memory
  bullet fix TOPIC        Safe Termux fix/checklist mode
  bullet bigfix           Run big-fix checklist
  bullet legend [upgrade] Auto build/update/install/test runner
  bullet test             Run built-in self-test
  bullet config KEY [MODEL] [BASE_URL]
  bullet note TEXT        Save a tiny note
  bullet notes            Show notes
  bullet run COMMAND      Run a shell command
  bullet sys              Show phone/Linux info
  bullet doctor           Check setup
  bullet install          Copy to \$PREFIX/bin/bullet

Env:
  BULLET_OFFLINE=1/true   Force offline answers
  BULLET_LEGEND_UPGRADE=1 Auto-run package upgrade in legend mode
  BULLET_API_KEY, BULLET_MODEL, BULLET_API_BASE, BULLET_HOME

Mini shell commands:
  /ask TEXT, /chat TEXT, /offline TEXT, /agi TEXT, /fix TEXT, /legend, /bigfix, /test, /note TEXT, /notes, /run COMMAND, /sys, /help, /exit
EOF
}

mini_shell() {
  printf 'Bullet mini shell. Type /help or /exit. Plain text asks AI/offline recipes.\n'
  while :; do
    printf 'bullet> '
    IFS= read -r line || break
    case "$line" in
      '') ;;
      /exit|exit|quit|/quit) break ;;
      /help) usage ;;
      /ask\ *) ai "${line#/ask }" ;;
      /offline\ *) offline_ai "${line#/offline }" ;;
      /chat|/bot) chat_bot ;;
      /chat\ *) chat_cmd "${line#/chat }" ;;
      /bot\ *) chat_cmd "${line#/bot }" ;;
      /agi\ memory) agi_cmd memory ;;
      /agi\ tasks) agi_cmd tasks ;;
      /agi\ remember\ *) agi_cmd remember "${line#/agi remember }" ;;
      /agi\ *) agi_goal "${line#/agi }" ;;
      /fix\ *) fix_cmd "${line#/fix }" ;;
      /legend|/auto) legend_cmd ;;
      /legend\ *) legend_cmd "${line#/legend }" ;;
      /auto\ *) legend_cmd "${line#/auto }" ;;
      /bigfix|/big-fix) fix_cmd big ;;
      /test) self_test ;;
      /note\ *) add_note "${line#/note }" ;;
      /notes) show_notes ;;
      /run\ *) sh -c "${line#/run }" ;;
      /sys) show_sys ;;
      /*) printf 'Unknown command. Type /help.\n' >&2 ;;
      *) ai "$line" ;;
    esac
  done
}

cmd="${1:-shell}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  shell) mini_shell ;;
  ask|a) ai "$@" ;;
  offline|off) offline_ai "$@" ;;
  chat|bot) chat_cmd "$@" ;;
  agi|agent) agi_cmd "$@" ;;
  fix|repair) fix_cmd "$@" ;;
  legend|auto|autofix) legend_cmd "$@" ;;
  upgrade|update|build|all) legend_cmd "$cmd" "$@" ;;
  bigfix|big-fix|fixall) fix_cmd big ;;
  test|selftest|check) self_test ;;
  config) save_config "$@" ;;
  note) add_note "$@" ;;
  notes) show_notes ;;
  run|sh) sh -c "$*" ;;
  sys) show_sys ;;
  doctor) doctor ;;
  install) install_self ;;
  help|-h|--help) usage ;;
  version|-v|--version) printf '%s\n' "$VERSION" ;;
  *) printf 'Unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
